{
  "name": "F2-67_物体ファイル接続_検証",
  "note": "2026-09-04 F2-66bを複製し短く縮めた検証用。MobileSAM+物体ファイルを本番の走行(train)の中で動かせるかの確認（F/docs/物体ファイルと注意/仕様_物体ファイルプラグイン接続_2026-09-04.md）。",
  "scene": "座位_12ヶ月_F2-49_実物8択_r1_個体1_2026-09-03",
  "taro": {
    "actuation": "muscle",
    "age_months": 12.0,
    "orienting_reflex": true,
    "hearing": true,
    "lexicon_vision": {
      "backend": "dinov2_vits14",
      "fovea_px": 32,
      "eye": "left",
      "source": "wide"
    },
    "lexicon_mode": "contrast",
    "lexicon_eta_pull": 0.05,
    "lexicon_eta_push": 0.0,
    "model": "F/models/F2-50_r8_seed98_2026-09-03.pt",
