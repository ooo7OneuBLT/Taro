    },
    "object_files": {
      "events_out": "F/logs/F2-74_M2_消失発話/物体ファイル.csv",
      "points_per_side": 16,
      "frames_out": "F/logs/F2-74_M2_消失発話/検出フレーム"
    },
    "view_video": {
      "out": "F/logs/F2-74_M2_消失発話/動画_視界.mp4",
      "until": 300
    }
  }
