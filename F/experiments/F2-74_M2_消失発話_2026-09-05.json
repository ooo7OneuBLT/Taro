{
  "name": "F2-74_M2_消失発話",
  "note": "2026-09-05 M2 物が消えた瞬間に親が「○○ないね」と言う場面の成立確認。F2-73b_M1.5_視界動画を複製し、sceneを消失発話シーンへ、run.steps=300へ変更。仕様：F/docs/二語文/仕様_M2_消えた瞬間に親が「○○ないね」と言う_2026-09-05.md。word_learningプラグインを追加（照合スクリプトが読む親の発話ログ=発話イベント.csvを出すため。F2-73bには無かった＝新規実験ファイルでの判断。詳細は報告参照）。",
  "scene": "座位_12ヶ月_F2-49_実物8択_r1_個体1_消失発話_2026-09-05",
  "taro": {
    "actuation": "muscle",
    "age_months": 12.0,
    "orienting_reflex": true,
    "hearing": true,
    "lexicon_vision": {
      "backend": "dinov2_vits14",
      "fovea_px": 32,
      "eye": "left",
      "source": "wide"
    },
    "lexicon_mode": "contrast",
    "lexicon_eta_pull": 0.05,
    "lexicon_eta_push": 0.0,
    "model": "F/models/F2-50_r8_seed98_2026-09-03.pt",
    "save": "F/logs/F2-74_M2_消失発話/model.pt",
    "produce": {
      "mode": "word",
      "threshold": 0.5,
      "cooldown_sec": 2.0,
      "max_length": 8,
      "develop_from_age": true,
      "vocal_tract_decoupled": true,
      "context": true,
      "listen_learn": false,
      "context_lambda": 0.0,
      "vision_context": true,
      "listen_lr": 0.001,
      "hippocampus": {
        "capacity": 512,
        "decay": 0.5,
        "replay_passes": 1,
        "recent_ratio": 0.7,
        "sleep_lr": 0.005
      },
      "word_choice": "gru_hippo",
      "hippo_gain": 1.0,
      "listen_self": false,
      "listen_eos": true,
      "segment_mode": "end_prob"
    }
  },
  "run": {
    "type": "train",
    "steps": 300,
    "seed": 91,
    "K": 10,
    "checkpoint": 100,
    "csv": "F/logs/F2-74_M2_消失発話/run.csv"
  },
  "plugins": {
    "word_production": {
      "events_out": "F/logs/F2-74_M2_消失発話/太郎の発話.csv"
    },
    "word_learning": {
