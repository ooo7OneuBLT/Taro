73;exitDx=0;exitDy=0;entryX=0.000;entryY=0.568;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;spacing=3;strokeColor=#bbbbbb;strokeWidth=1;labelBorderColor=#9a9a9a;fontColor=#111111;dashed=1;" edge="1" parent="1" source="n_worth" target="n_stress"><mxGeometry x="0.480" relative="1" as="geometry"><Array as="points"><mxPoint x="2938" y="326" /><mxPoint x="2938" y="4000" /><mxPoint x="1485" y="4000" /><mxPoint x="1485" y="3888" /></Array></mxGeometry></mxCell></UserObject><UserObject id="e112" label="" tooltip="入口の音量つまみ → 目の入口&#10;中身：（?）&#10;投射の存在と向き：確立／根拠の動物：&#10;【注】元の矢印の中身：中継の通し具合を下げる抑制（注意が向かない入力を抑える） ／ 注意先で皮質どうしの同期を高める信号&#10;【出典】&#10;"><mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;jumpStyle=arc;rounded=1;exitX=0.000;exitY=0.647;exitDx=0;exitDy=0;entryX=0.000;entryY=0.764;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;spacing=3;strokeColor=#bbbbbb;strokeWidth=1;labelBorderColor=#9a9a9a;fontColor=#111111;dashed=1;" edge="1" parent="1" source="n_volume" target="n_eyein"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="5487" /><mxPoint x="380" y="3980" /></Array></mxGeometry></mxCell></UserObject><UserObject id="e113" label="" tooltip="入口の音量つまみ → こわい・うれしいの重み付け&#10;中身：（?）&#10;投射の存在と向き：有力／根拠の動物：&#10;【注】元の矢印の中身：粗い顔らしさ・怖い表情の素早い知らせ（低い空間周波数）&#10;【出典】&#10;"><mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;jumpStyle=arc;rounded=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.754;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;spacing=3;strokeColor=#bbbbbb;strokeWidth=1;labelBorderColor=#9a9a9a;dashed=1;dashPattern=6 4;fontColor=#111111;" edge="1" parent="1" source="n_volume" target="n_feel"><mxGeometry x="-0.320" relative="1" as="geometry"><Array as="points"><mxPoint x="3400" y="5457" /><mxPoint x="3400" y="744" /></Array></mxGeometry></mxCell></UserObject><UserObject id="e114" label="" tooltip="動きのずれを直す係 → 目の出口&#10;中身：（?）&#10;投射の存在と向き：確立／根拠の動物：&#10;【注】元の矢印の中身：サッケードの大きさと精度の微調整&#10;【出典】&#10;"><mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;jumpStyle=arc;rounded=1;exitX=0.000;exitY=0.432;exitDx=0;exitDy=0;entryX=0.000;entryY=0.587;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;spacing=3;strokeColor=#bbbbbb;strokeWidth=1;labelBorderColor=#9a9a9a;fontColor=#111111;dashed=1;" edge="1" parent="1" source="n_cb" target="n_eyeout"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="2107" y="3858" /><mxPoint x="2107" y="4376" /></Array></mxGeometry></mxCell></UserObject><UserObject id="e115" label="" tooltip="見えた方へ目を向ける反射 → 動きのずれを直す係&#10;中身：（?）&#10;投射の存在と向き：有力／根拠の動物：&#10;【注】元の矢印の中身：目標の位置・サッケード指令の写し&#10;【出典】&#10;"><mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;jumpStyle=arc;rounded=1;exitX=1.000;exitY=0.564;exitDx=0;exitDy=0;entryX=1.000;entryY=0.705;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;spacing=3;strokeColor=#bbbbbb;strokeWidth=1;labelBorderColor=#9a9a9a;dashed=1;dashPattern=6 4;fontColor=#111111;" edge="1" parent="1" source="n_orienteye" target="n_cb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="1385" y="2932" /><mxPoint x="1385" y="2999" /><mxPoint x="2567" y="2999" /><mxPoint x="2567" y="3918" /></Array></mxGeometry></mxCell></UserObject><UserObject id="e116" label="" tooltip="体の出口 → 動きのずれを直す係&#10;中身：（?）&#10;投射の存在と向き：確立／根拠の動物：&#10;【注】元の矢印の中身：手足の運動指令の写し&#10;【出典】&#10;"><mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;jumpStyle=arc;rounded=1;exitX=0.000;exitY=0.660;exitDx=0;exitDy=0;entryX=0.000;entryY=0.568;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;spacing=3;strokeColor=#bbbbbb;strokeWidth=1;labelBorderColor=#9a9a9a;fontColor=#111111;dashed=1;" edge="1" parent="1" source="n_bodyout" target="n_cb"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="2077" y="4761" /><mxPoint x="2077" y="3888" /></Array></mxGeometry></mxCell></UserObject><mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:12px;line-height:19px&quot;&gt;箱＝脳の「係」。いくつかの部位を、同じ仕事ごとにまとめたもの&lt;br&gt;&lt;b&gt;太字&lt;/b&gt;＝その係の役割&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;受け取る&lt;/b&gt;&lt;/font&gt;＝何を、どの係から受け取るか&lt;br&gt;&lt;font color=&quot;#1f5c99&quot;&gt;&lt;b&gt;渡す&lt;/b&gt;&lt;/font&gt;＝何を、どの係へ渡すか&lt;br&gt;矢印＝箱の中に書いた受け渡しと同じもの。実線＝確か／破線＝有力または仮説&lt;br&gt;〔DA〕ドーパミン〔NA〕ノルアドレナリン〔5HT〕セロトニン〔ACh〕アセチルコリン〔OXT〕オキシトシンを受け取る&lt;br&gt;灰色の行＝脳の場所（詳しくは「行動を決める段」「解剖の入れ子」ページ）&lt;br&gt;矢印にマウスを乗せると、元の部位どうしの矢印の中身が出る&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#fffbe6;strokeColor=#c9a400;spacing=8;" vertex="1" parent="1"><mxGeometry x="3470" y="40" width="440" height="260" as="geometry" /></mxCell><UserObject id="e_new_listen_semantic" label="荷札 ★追加（図の書き漏れ）" tooltip="聞き分ける係 → 意味の辞書（2026-10-15追加）&#10;聞いた語を側頭葉で意味と結び付ける道。元の図に無かった"><mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;rounded=1;strokeColor=#d9480f;strokeWidth=3.5;fontColor=#d9480f;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_listen" target="n_semantic"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><mxCell id="legend_v2" value="&lt;b style=&quot;font-size:20px&quot;&gt;core_v2 段階3の設計図（2026-10-15）&lt;/b&gt;&lt;br&gt;段階2の配線はそのまま。変えるのは緑の2係と緑の矢印1本だけ&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background:#a9d18e&quot;&gt;　　　&lt;/span&gt; &lt;b&gt;段階3で変える係&lt;/b&gt;：見えた方へ目を向ける反射（復帰抑制を足す）／意味の辞書（経験から学ぶ）&lt;br&gt;&lt;span style=&quot;background:#f4b183&quot;&gt;　　　&lt;/span&gt; 段階2の働く仮部品（そのまま）&lt;br&gt;&lt;span style=&quot;background:#9dc3e6&quot;&gt;　　　&lt;/span&gt; 旧太郎・環境から借りる&lt;br&gt;&lt;span style=&quot;background:#eeeeee&quot;&gt;　　　&lt;/span&gt; 素通し&lt;br&gt;&lt;font color=&quot;#d9480f&quot;&gt;&lt;b&gt;━━ 太い橙の矢印&lt;/b&gt;&lt;/font&gt;：「ボールはどこ？」で通る道（段階2から）&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;━━ 太い緑の矢印&lt;/b&gt;&lt;/font&gt;：段階3で中身を流し始める道（目の入口 → 意味の辞書）&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;- - - 細い灰色の矢印&lt;/font&gt;：つないであるが、空っぽが流れる&lt;br&gt;&lt;br&gt;&lt;b&gt;学ぶ場面&lt;/b&gt;：親が物を振って見せ、太郎が3秒見続けたら名前を言う（環境の「親が名づける仕組み」）。名前は耳の入口→聞き分ける係→意味の辞書へ、見ている物は目の入口→意味の辞書へ届く&lt;br&gt;&lt;b&gt;合格の線&lt;/b&gt;：①探し物が無いとき3つの物を全部見て回る ②段階2の合格が崩れない ③学ぶ前は分からない ④名前を5回ずつ聞いた後は分かる ⑤名前を入れ替えて教えると入れ替わった方を見る" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fffdf5;strokeColor=#d9480f;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="-430" width="1250" height="400" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>