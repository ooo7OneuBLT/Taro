<mxfile host="Claude" type="device"><diagram id="simple" name="やさしい版（段と入出力）"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3970" pageHeight="5671" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="n_brain" label="脳の係の地図（やさしい版）" tooltip="脳の係の地図（やさしい版）"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#fbfbfb;strokeColor=#5a5a5a;strokeWidth=1.6;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="3370" height="5571" as="geometry"/></mxCell></UserObject><UserObject id="n_mem" label="記憶" tooltip="記憶&#10;どの段にも、思い出したことを横から渡す"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#fbfbfb;strokeColor=#5a5a5a;strokeWidth=1.6;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_brain"><mxGeometry x="26" y="40" width="412" height="1238" as="geometry"/></mxCell></UserObject><mxCell id="r_mem" value="どの段にも、思い出したことを横から渡す" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_mem"><mxGeometry x="26" y="38" width="360" height="30" as="geometry"/></mxCell><UserObject id="n_episodic" label='1回で覚える記憶帳 &lt;font color="#c55a00"&gt;〔DA〕&lt;/font&gt;' tooltip="1回で覚える記憶帳&#10;役割：いつ・どこで・何があったかを1回で覚え、欠けた手がかりから全体を思い出す。眠っている間に大脳へ移す&#10;受け取る：物の見た目（目の入口から）&#10;受け取る：位置と向き（場所と道の地図から）&#10;受け取る：体の状態（体の内側を感じる係から）&#10;渡す：思い出した出来事と場所（得を見積もる係・目的をやりくりする係へ）&#10;渡す：場所の文脈（こわい・うれしいの重み付けへ）&#10;生得か学習か：学び方が分かる（同時に起きたことを結びつけて1回で覚える）&#10;場所：海馬・嗅内皮質・傍海馬皮質・嗅周皮質"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#ffffff;strokeColor=#5a5a5a;strokeWidth=1.2;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_mem"><mxGeometry x="26" y="76" width="360" height="268" as="geometry"/></mxCell></UserObject><mxCell id="r_episodic" value='&lt;b&gt;いつ・どこで・何があったかを1回で覚え、欠けた手がかりから全体を思い出す。眠っている間に大脳へ移す&lt;/b&gt;&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;物の見た目（目の入口から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;位置と向き（場所と道の地図から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;体の状態（体の内側を感じる係から）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;思い出した出来事と場所（得を見積もる係・目的をやりくりする係へ）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;場所の文脈（こわい・うれしいの重み付けへ）&lt;br&gt;&lt;font color="#8a5a00"&gt;生得か学習か：学び方が分かる（同時に起きたことを結びつけて1回で覚える）&lt;/font&gt;&lt;br&gt;&lt;font color="#777777"&gt;場所：海馬・嗅内皮質・傍海馬皮質・嗅周皮質&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_episodic"><mxGeometry x="14" y="38" width="332" height="222" as="geometry"/></mxCell><UserObject id="n_semantic" label="意味の辞書" tooltip="意味の辞書&#10;役割：物や語の意味を、見た目・音・使い方をまとめて覚える。初めて見る物にも語を当てはめる土台&#10;受け取る：見た目の特徴（目の入口から）&#10;受け取る：思い出したこと（記憶帳から）&#10;受け取る：感情の重み（こわい・うれしいの重み付けから）&#10;渡す：語・物の意味の候補（言う語を組み立てる係・目的を持ち続ける係へ）&#10;渡す：意味の素材（2語を合わせる係へ）&#10;渡す：価値（得を見積もる係へ）&#10;生得か学習か：学び方は未解明（候補：ゆっくりした統計的な学習）&#10;場所：前部側頭葉・側頭極・中側頭回後部・角回"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#ffffff;strokeColor=#5a5a5a;strokeWidth=1.2;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_mem"><mxGeometry x="26" y="534" width="360" height="268" as="geometry"/></mxCell></UserObject><mxCell id="r_semantic" value='&lt;b&gt;物や語の意味を、見た目・音・使い方をまとめて覚える。初めて見る物にも語を当てはめる土台&lt;/b&gt;&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;見た目の特徴（目の入口から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;思い出したこと（記憶帳から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;感情の重み（こわい・うれしいの重み付けから）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;語・物の意味の候補（言う語を組み立てる係・目的を持ち続ける係へ）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;意味の素材（2語を合わせる係へ）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;価値（得を見積もる係へ）&lt;br&gt;&lt;font color="#8a5a00"&gt;生得か学習か：学び方は未解明（候補：ゆっくりした統計的な学習）&lt;/font&gt;&lt;br&gt;&lt;font color="#777777"&gt;場所：前部側頭葉・側頭極・中側頭回後部・角回&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_semantic"><mxGeometry x="14" y="38" width="332" height="222" as="geometry"/></mxCell><UserObject id="n_map" label="場所と道の地図" tooltip="場所と道の地図&#10;役割：自分がどこにいて、どちらを向いているか、何がどこにあるかを表す&#10;受け取る：思い出した場所（記憶帳から）&#10;受け取る：頭の向き（体の動きの情報から）&#10;渡す：位置・向き・距離（記憶帳へ）&#10;渡す：自分の視点での場面（得を見積もる係へ）&#10;生得か学習か：生まれつきの骨組み＋学習（学び方は未解明）&#10;場所：内側嗅内皮質・前海馬台・脳梁膨大後部皮質・視床前核・後帯状皮質・楔前部"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#ffffff;strokeColor=#5a5a5a;strokeWidth=1.2;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_mem"><mxGeometry x="26" y="992" width="360" height="220" as="geometry"/></mxCell></UserObject><mxCell id="r_map" value='&lt;b&gt;自分がどこにいて、どちらを向いているか、何がどこにあるかを表す&lt;/b&gt;&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;思い出した場所（記憶帳から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;頭の向き（体の動きの情報から）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;位置・向き・距離（記憶帳へ）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;自分の視点での場面（得を見積もる係へ）&lt;br&gt;&lt;font color="#8a5a00"&gt;生得か学習か：生まれつきの骨組み＋学習（学び方は未解明）&lt;/font&gt;&lt;br&gt;&lt;font color="#777777"&gt;場所：内側嗅内皮質・前海馬台・脳梁膨大後部皮質・視床前核・後帯状皮質・楔前部&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_map"><mxGeometry x="14" y="38" width="332" height="174" as="geometry"/></mxCell><UserObject id="n_ladder" label="行動を決める段（上ほど抽象的）" tooltip="行動を決める段（上ほど抽象的）&#10;下の段ほど生まれつきの反射、上の段ほど目的や考えで行動を決める"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#fbfbfb;strokeColor=#5a5a5a;strokeWidth=1.6;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_brain"><mxGeometry x="628" y="40" width="2114" height="3417" as="geometry"/></mxCell></UserObject><mxCell id="r_ladder" value="下の段ほど生まれつきの反射、上の段ほど目的や考えで行動を決める" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_ladder"><mxGeometry x="26" y="38" width="2062" height="30" as="geometry"/></mxCell><UserObject id="n_r4" label="4段目　考える" tooltip="4段目　考える&#10;目的どうしをやりくりし、関係を組み合わせて考える"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#fbfbfb;strokeColor=#5a5a5a;strokeWidth=1.6;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_ladder"><mxGeometry x="851" y="76" width="412" height="306" as="geometry"/></mxCell></UserObject><mxCell id="r_r4" value="目的どうしをやりくりし、関係を組み合わせて考える" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_r4"><mxGeometry x="26" y="38" width="360" height="30" as="geometry"/></mxCell><UserObject id="n_plan" label="目的をやりくりする係" tooltip="目的をやりくりする係&#10;役割：今の目的をいったん保留して別のことをし、あとで戻る。2つの関係を組み合わせて考える（類推）&#10;受け取る：今やっている作業の途中経過（目的を持ち続ける係から）&#10;受け取る：失敗や負担の知らせ（見張り係から）&#10;受け取る：何が大事か（得を見積もる係から）&#10;渡す：どの目的を優先するか（目的を持ち続ける係へ）&#10;生得か学習か：学び方は未解明&#10;場所：前頭極"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#ffffff;strokeColor=#5a5a5a;strokeWidth=1.2;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_r4"><mxGeometry x="26" y="76" width="360" height="204" as="geometry"/></mxCell></UserObject><mxCell id="r_plan" value='&lt;b&gt;今の目的をいったん保留して別のことをし、あとで戻る。2つの関係を組み合わせて考える（類推）&lt;/b&gt;&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;今やっている作業の途中経過（目的を持ち続ける係から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;失敗や負担の知らせ（見張り係から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;何が大事か（得を見積もる係から）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;どの目的を優先するか（目的を持ち続ける係へ）&lt;br&gt;&lt;font color="#8a5a00"&gt;生得か学習か：学び方は未解明&lt;/font&gt;&lt;br&gt;&lt;font color="#777777"&gt;場所：前頭極&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_plan"><mxGeometry x="14" y="38" width="332" height="158" as="geometry"/></mxCell><UserObject id="n_r3" label="3段目　目的を持ち続ける" tooltip="3段目　目的を持ち続ける&#10;見えなくなった目的を頭に置き続け、下の段を引っぱる"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#fbfbfb;strokeColor=#5a5a5a;strokeWidth=1.6;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_ladder"><mxGeometry x="301" y="572" width="1512" height="911" as="geometry"/></mxCell></UserObject><mxCell id="r_r3" value="見えなくなった目的を頭に置き続け、下の段を引っぱる" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_r3"><mxGeometry x="26" y="38" width="1460" height="30" as="geometry"/></mxCell><UserObject id="n_goal" label='目的を持ち続ける係 &lt;font color="#c55a00"&gt;〔DA・NA・5HT・ACh〕&lt;/font&gt;' tooltip="目的を持ち続ける係&#10;役割：見えなくなった目的やルールを頭に置き続け、下の係をその方向へ引っぱる。ルールの切り替え&#10;受け取る：聞いた語（聞き分ける係から）&#10;受け取る：いま見ている場所（目を向ける先を選ぶ係から）&#10;受け取る：語・物の意味（意味の辞書から）&#10;受け取る：「入れ替えてよい」の許可（門番から）&#10;渡す：今回のルール・探している物（目を向ける先を選ぶ係へ）&#10;渡す：次の候補（門番へ）&#10;渡す：何を通すか（入口の音量つまみへ）&#10;渡す：言う語の計画（声と口の係へ）&#10;生得か学習か：学び方は未解明（候補：門番がドーパミンで入れ替え時を学ぶ）&#10;場所：背外側前頭前野・腹外側前頭前野・下前頭接合部"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=49;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#ffffff;strokeColor=#5a5a5a;strokeWidth=1.2;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_r3"><mxGeometry x="26" y="76" width="360" height="319" as="geometry"/></mxCell></UserObject><mxCell id="r_goal" value='&lt;b&gt;見えなくなった目的やルールを頭に置き続け、下の係をその方向へ引っぱる。ルールの切り替え&lt;/b&gt;&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;聞いた語（聞き分ける係から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;いま見ている場所（目を向ける先を選ぶ係から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;語・物の意味（意味の辞書から）&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;「入れ替えてよい」の許可（門番から）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;今回のルール・探している物（目を向ける先を選ぶ係へ）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;次の候補（門番へ）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;何を通すか（入口の音量つまみへ）&lt;br&gt;&lt;font color="#1f5c99"&gt;&lt;b&gt;渡す：&lt;/b&gt;&lt;/font&gt;言う語の計画（声と口の係へ）&lt;br&gt;&lt;font color="#8a5a00"&gt;生得か学習か：学び方は未解明（候補：門番がドーパミンで入れ替え時を学ぶ）&lt;/font&gt;&lt;br&gt;&lt;font color="#777777"&gt;場所：背外側前頭前野・腹外側前頭前野・下前頭接合部&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;fillColor=#ffffff;strokeColor=#c8c8c8;fontSize=11;fontColor=#222222;movable=0;" vertex="1" parent="n_goal"><mxGeometry x="14" y="57" width="332" height="254" as="geometry"/></mxCell><UserObject id="n_monitor" label='まちがい・迷いを見張る係 &lt;font color="#c55a00"&gt;〔DA・NA〕&lt;/font&gt;' tooltip="まちがい・迷いを見張る係&#10;役割：うまくいっていない・迷っているに気づき、もっと集中するよう合図する&#10;受け取る：体と気持ちの状態（体の内側を感じる係から）&#10;受け取る：予想とのずれ（ドーパミン）&#10;渡す：失敗・負担の知らせ（目的をやりくりする係へ）&#10;渡す：切り替えを（ノルアドレナリンの源へ）&#10;渡す：感情の声を出す・出さない（泣き声の係へ）&#10;生得か学習か：学び方は未解明&#10;場所：前部帯状皮質"><mxCell style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=49;rounded=1;arcSize=6;fontStyle=1;fontSize=14;fontColor=#1a1a1a;fillColor=#d9d9d9;swimlaneFillColor=#ffffff;strokeColor=#5a5a5a;strokeWidth=1.2;collapsible=1;recursiveResize=0;childLayout=;whiteSpace=wrap;" vertex="1" parent="n_r3"><mxGeometry x="576" y="76" width="360" height="239" as="geometry"/></mxCell></UserObject><mxCell id="r_monitor" value='&lt;b&gt;うまくいっていない・迷っているに気づき、もっと集中するよう合図する&lt;/b&gt;&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;受け取る：&lt;/b&gt;&lt;/font&gt;体と気持ちの状態（体の内側を感じる係から）&lt;br&gt;&lt;