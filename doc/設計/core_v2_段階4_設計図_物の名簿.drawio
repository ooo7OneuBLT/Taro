<mxfile host="app.diagrams.net"><diagram id="stage4" name="段階4 物の名簿"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;core_v2 段階4の設計図：物の名簿（頭頂葉の役）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="青＝今ある係　橙＝段階4で足す・変える　灰＝今回は触らない。左が今（段階3）、右が段階4。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;opacity=40;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="680" height="560" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;今（段階3）：物の情報が3か所にばらばら&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="640" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;目の入口&lt;/b&gt;&lt;br&gt;物を毎回その場で拾う" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="150" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;目を向ける反射&lt;/b&gt;&lt;br&gt;・いつ撃つか&lt;br&gt;・&lt;u&gt;「もう見た」「慣れ」の印&lt;/u&gt;（物に寄せる・まとめる・待つ）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="160" width="260" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;意味の辞書&lt;/b&gt;（経験で覚える）&lt;br&gt;・覚える・思い出す&lt;br&gt;・&lt;u&gt;直前1秒の窓で「見ていた物」を決め直す&lt;/u&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="260" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;目を向ける先を選ぶ係&lt;/b&gt;&lt;br&gt;1コマ抜けると、その物は無いことに" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="260" height="70" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="コップが「胴」と「底の線」に割れると、3か所がそれぞれ別の物として扱う → 印と名前がずれる → 数字を足して合わせた（継ぎはぎ）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="610" height="80" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;opacity=40;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="800" height="560" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;段階4：名簿に物ごとにまとめる&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="780" y="108" width="760" height="30" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;目の入口&lt;/b&gt;&lt;br&gt;（変えない）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="120" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;物の名簿&lt;/b&gt;（新しい係・頭頂葉）&lt;br&gt;&lt;br&gt;物ごとに1行、最大4行&lt;br&gt;・割れた物を「一緒に動いたら」1つに&lt;br&gt;・1コマ見失っても残る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1020" y="280" width="200" height="170" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;目を向ける反射&lt;/b&gt;&lt;br&gt;「いつ撃つか」だけに戻る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1280" y="160" width="260" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;意味の辞書&lt;/b&gt;&lt;br&gt;「覚える・思い出す」だけに戻る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1280" y="320" width="260" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;目を向ける先を選ぶ係&lt;/b&gt;&lt;br&gt;名簿の行を見る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1280" y="470" width="260" height="70" as="geometry"/></mxCell><mxCell id="c20" value="物ごとの荷札と地図&lt;br&gt;目の動きの地図" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="もう見た地図&lt;br&gt;今の行の慣れ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="今見ている行の荷札" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="行ごとの荷札と地図" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="書式は今の4種類のまま（荷札・地図・数字1つ）。脳の構造図は41係 → 42係（目の入口と注意の係の間に「物の名簿」）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="790" y="560" width="750" height="80" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;名簿の中身（例：コップを振って見せている場面）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="700" height="30" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;番号&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="725" width="60" height="36" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;見た目&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="100" y="725" width="200" height="36" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;場所&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="725" width="90" height="36" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;慣れ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="390" y="725" width="120" height="36" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;もう見た&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="510" y="725" width="120" height="36" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;最後に見えた&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="630" y="725" width="110" height="36" as="geometry"/></mxCell><mxCell id="c32" value="①" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="761" width="60" height="36" as="geometry"/></mxCell><mxCell id="c33" value="ボール" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="100" y="761" width="200" height="36" as="geometry"/></mxCell><mxCell id="c34" value="左" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="761" width="90" height="36" as="geometry"/></mxCell><mxCell id="c35" value="0.4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="390" y="761" width="120" height="36" as="geometry"/></mxCell><mxCell id="c36" value="0.6（離れた）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="510" y="761" width="120" height="36" as="geometry"/></mxCell><mxCell id="c37" value="今" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="630" y="761" width="110" height="36" as="geometry"/></mxCell><mxCell id="c38" value="②" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="797" width="60" height="36" as="geometry"/></mxCell><mxCell id="c39" value="コップ（胴＋底を1つに）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="100" y="797" width="200" height="36" as="geometry"/></mxCell><mxCell id="c40" value="真ん中" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="797" width="90" height="36" as="geometry"/></mxCell><mxCell id="c41" value="0.2（見ている）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="390" y="797" width="120" height="36" as="geometry"/></mxCell><mxCell id="c42" value="0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="510" y="797" width="120" height="36" as="geometry"/></mxCell><mxCell id="c43" value="今" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="630" y="797" width="110" height="36" as="geometry"/></mxCell><mxCell id="c44" value="③" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="833" width="60" height="36" as="geometry"/></mxCell><mxCell id="c45" value="光って動く物" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="100" y="833" width="200" height="36" as="geometry"/></mxCell><mxCell id="c46" value="右下" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="833" width="90" height="36" as="geometry"/></mxCell><mxCell id="c47" value="0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="390" y="833" width="120" height="36" as="geometry"/></mxCell><mxCell id="c48" value="0.3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="510" y="833" width="120" height="36" as="geometry"/></mxCell><mxCell id="c49" value="今" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="630" y="833" width="110" height="36" as="geometry"/></mxCell><mxCell id="c50" value="④" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="869" width="60" height="36" as="geometry"/></mxCell><mxCell id="c51" value="（空き）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="100" y="869" width="200" height="36" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="869" width="90" height="36" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="390" y="869" width="120" height="36" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="510" y="869" width="120" height="36" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="630" y="869" width="110" height="36" as="geometry"/></mxCell><mxCell id="c56" value="手で決める（生まれつき）：行数・同じ物の決め方・まとめる決まり・慣れと薄れ方の形。&lt;br&gt;経験で変わる：どの物が名簿にいるか、それぞれの慣れ具合（学習するNNではない）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="912" width="700" height="60" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;割れた物を1つにまとめる（赤ちゃんの「一緒に動く物は1つ」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="780" y="690" width="760" height="30" as="geometry"/></mxCell><mxCell id="c58" value="行②　胴" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="790" y="740" width="110" height="50" as="geometry"/></mxCell><mxCell id="c59" value="行④　底の線" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="790" y="800" width="110" height="40" as="geometry"/></mxCell><mxCell id="c60" value="親が振る／目が動く&lt;br&gt;→ 2つが一緒に動く" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="755" width="180" height="70" as="geometry"/></mxCell><mxCell id="c61" value="行②　コップ&lt;br&gt;（見た目は2つの平均、名前もここで1回ずつ覚える）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1260" y="750" width="260" height="80" as="geometry"/></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c58" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c59" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c60" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="止まっている別の物どうしは、隣り合っていてもまとめない（一緒に動かないので）。&lt;br&gt;根拠：Kellman・Spelke 1983（4か月児、共通の動き）、Xu・Carey 1996（場所と動きのつながりで物を数える）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="860" width="750" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>